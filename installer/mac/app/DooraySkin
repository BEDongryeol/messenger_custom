#!/bin/bash
# Dooray Skin.app 실행 파일 (더블클릭 한 번으로 전부 처리)
#  1) 받은 위치(다운로드 폴더 등)에서 실행되면 ~/Applications/Dooray Skin.app 으로 자기 자신을 설치(업데이트)
#  2) (Dock 은 건드리지 않는다. 원하면 사용자가 Dooray Skin 을 직접 Dock 에 고정)
#  3) 배경 기능을 넣어 Dooray 실행 (실행 중이면 자동 재시작)
SELF_APP="$(cd "$(dirname "$0")/../.." && pwd -P)"
TARGET="$HOME/Applications/Dooray Skin.app"
DATA="$HOME/Library/Application Support/DooraySkin"
mkdir -p "$DATA"
LOG="$DATA/app.log"
log() { echo "[$(date '+%F %T')] $*" >> "$LOG"; }
notify() { /usr/bin/osascript -e "display notification \"$1\" with title \"Dooray Skin\"" >/dev/null 2>&1 || true; }

# 0) Dooray 찾기
APP=""
for p in "/Applications/Dooray Messenger.app" "$HOME/Applications/Dooray Messenger.app"; do
  [ -d "$p" ] && APP="$p" && break
done
[ -z "$APP" ] && APP="$(/usr/bin/mdfind "kMDItemCFBundleIdentifier == 'com.dooray.messenger'" 2>/dev/null | head -1)"
if [ -z "$APP" ] || [ ! -d "$APP" ]; then
  notify "Dooray Messenger 앱을 찾지 못했습니다. 먼저 Dooray Messenger 를 설치해 주세요."
  log "dooray app not found"
  exit 1
fi

# 1) 자기 설치 / 업데이트
if [ "$SELF_APP" != "$(cd "$TARGET" 2>/dev/null && pwd -P)" ]; then
  mkdir -p "$HOME/Applications"
  rm -rf "$TARGET"
  if /usr/bin/ditto "$SELF_APP" "$TARGET"; then
    /usr/bin/xattr -dr com.apple.quarantine "$TARGET" 2>/dev/null || true
    log "installed from $SELF_APP"
    FIRST_INSTALL=1
  else
    log "install copy failed, running in place"
    TARGET="$SELF_APP"
  fi
fi
RES="$TARGET/Contents/Resources"

# 아이콘: CI 빌드에는 Dooray 아이콘이 없으므로 이 Mac 에 설치된 Dooray 아이콘을 복사해 쓴다 (재배포하지 않음)
ICNS="$RES/AppIcon.icns"
if [ ! -s "$ICNS" ] && [ -f "$APP/Contents/Resources/electron.icns" ]; then
  cp "$APP/Contents/Resources/electron.icns" "$ICNS" 2>/dev/null && touch "$TARGET" && log "icon copied from Dooray"
fi

# 3) 실행
if ELECTRON_RUN_AS_NODE=1 "$APP/Contents/MacOS/Dooray Messenger" "$RES/launcher.js" >>"$LOG" 2>&1; then
  [ -n "${FIRST_INSTALL:-}" ] && notify "설치 완료. 앞으로 Launchpad/Spotlight 의 Dooray Skin 으로 실행하세요."
else
  notify "실행 실패. ~/Library/Application Support/DooraySkin/launcher.log 를 확인해 주세요."
  exit 1
fi
